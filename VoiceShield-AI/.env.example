# ==============================================================================
# VoiceShield AI - Environment Configuration Example
# AI-Powered Real-Time Voice-Cloning Impersonation Detection
# ==============================================================================

# General Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_DB=voiceshield_db
POSTGRES_USER=voiceshield_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Spring Boot Backend Service
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Detection Microservice (FastAPI + PyTorch)
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_ENVIRONMENT=development
HF_AUTH_TOKEN=YOUR_HUGGINGFACE_API_TOKEN_OPTIONAL

# Audio Pipeline Settings
MAX_AUDIO_SIZE_BYTES=10485760
AUDIO_RETENTION_HOURS=0
ENABLE_AUDIO_DISK_PERSISTENCE=false

# Risk Engine Thresholds
RISK_WEIGHT_AI_DETECTION=0.30
RISK_WEIGHT_SPEAKER_MISMATCH=0.20
RISK_WEIGHT_PROSODY_ANOMALY=0.15
RISK_WEIGHT_SPECTRAL_ANOMALY=0.15
RISK_WEIGHT_CROSS_SESSION=0.10
RISK_WEIGHT_CONTEXTUAL=0.10

# Frontend Configuration
FRONTEND_PORT=4200
BACKEND_API_BASE_URL=http://localhost:8080/api
WEBSOCKET_STREAM_URL=ws://localhost:8080/ws/audio-stream
